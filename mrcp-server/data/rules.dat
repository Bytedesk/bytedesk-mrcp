#规则版本
version:1

#是否启用正则匹配 0=禁用 1=启用
enable_regex:1

#本地缓存目录，此参数不支持热加载
local_cache_path: ./data/local_cache

#是否启用local_cache 0=禁用 1=启用
enable_local_cache:0
# regex syntax https://github.com/google/re2/wiki/Syntax
# '*', '+', '?', '(', ')', '|' in input need be escaped

[@rules]
input:#号键
output:井号键

[@rules]
input:\*号键
output:星号键
